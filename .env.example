# Public Supabase project values (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values. Set these on the Express host; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=your-secret-key
ARCADE_PASSCODE_PEPPER=replace-with-a-long-random-secret
